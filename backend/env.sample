PORT=4000
# PostgreSQL connection (use either DATABASE_URL or individual settings)
# For macOS Homebrew PostgreSQL, use your system username (not 'postgres')
DATABASE_URL=postgresql://girishwatwani@localhost:5432/ai_stock_insights
# Or use individual settings:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=ai_stock_insights
# POSTGRES_USER=girishwatwani
# POSTGRES_PASSWORD=
FINNHUB_API_KEY=your_finnhub_key
# Alpha Vantage API (free tier: https://www.alphavantage.co/support/#api-key)
# Free tier: 5 calls/minute, 500 calls/day. Use 'demo' for testing (limited).
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
MARKET_AUX_KEY=your_marketaux_key
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-3.5-turbo
OLLAMA_ENDPOINT=http://localhost:11434/api/generate
TRACKED_SYMBOLS=AAPL,MSFT,GOOGL
SEC_USER_AGENT=ai-stock-insights/1.0 (contact: you@example.com)
LOG_LEVEL=info

